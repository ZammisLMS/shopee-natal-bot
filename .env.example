# Credenciais oficiais Shopee Affiliate GraphQL (não comitar valores reais)
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# TRAVA GERAL: false = nenhum WhatsApp receberá ofertas
SEND_ENABLED=false

# Painel: gere no terminal com "openssl rand -hex 32" (mínimo 32 caracteres)
# O painel NÃO sobe sem token; em execução local escuta somente 127.0.0.1.
PANEL_TOKEN=
PANEL_HOST=127.0.0.1
PANEL_PORT=8787

# Escolha até 16 palavras por rodada, em rodízio por grupo
KEYWORDS_PER_SCAN=3
RESULTS_PER_QUERY=30
TIME_ZONE=America/Sao_Paulo
SESSION_DIR=./runtime/baileys
STATE_FILE=./runtime/state.json
GROUPS_FILE=./runtime/groups.json
LOG_LEVEL=info
